{
  "name": "compositore-diplomi",
  "version": "1.0.1",
  "description": "App desktop Windows per generare diplomi personalizzati in batch.",
  "author": "Alessandro Fabiani",
  "homepage": "https://github.com/scarulez/compositore-diplomi",
  "repository": {
    "type": "git",
    "url": "https://github.com/scarulez/compositore-diplomi.git"
  },
  "bugs": {
    "url": "https://github.com/scarulez/compositore-diplomi/issues"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "package": "npm run package:installer && npm run package:portable",
    "package:installer": "electron-builder --win nsis --x64 --publish never",
    "package:portable": "electron-builder --win portable --x64 --publish never"
  },
  "build": {
    "appId": "it.compositore.diplomi",
    "productName": "Compositore Diplomi",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "compression": "maximum",
    "win": {
      "signtoolOptions": {
        "publisherName": "Alessandro Fabiani"
      },
      "target": "nsis"
    }
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12"
  },
  "allowScripts": {
    "electron@37.10.3": true
  }
}
